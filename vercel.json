{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "excludeFiles": "{seed.py,seed_test_data.py,README.md,uploads/**}" }
    },
    { "src": "app/static/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/app/static/$1",
      "headers": { "Cache-Control": "public, max-age=3600, must-revalidate" }
    },
    { "src": "/(.*)", "dest": "api/index.py" }
  ],
  "env": {
    "VERCEL": "1"
  }
}
